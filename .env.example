# --- Anthropic (search + classify) ---
ANTHROPIC_API_KEY=
# Model used for the web-search classify pass. Override per deployment.
# Spec named claude-sonnet-4-6; current-generation alternative: claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Airtable (Data Center People + Health Logs) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appxfti7VuoHYUeu6

# --- Supabase (public.artifacts + automation_health_log) ---
SUPABASE_URL=https://ycadmmngkdhvpcsrcuaq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron / manual-trigger auth ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
# The same value gates the manual ?dry_run=true endpoint via ?secret=...
CRON_SECRET=

# --- Rotation tuning ---
# Records re-checked per nightly run (oldest Last Checked first).
BATCH_SIZE=40
